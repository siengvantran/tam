# Public URL: canonical links, sitemap, Stripe return links, emails
SITE_URL=https://tam.tv
# Bookings, uploads and sign-ups live here. On Railway, mount a volume and point this at it.
DATA_DIR=/data
# Staff: /admin (12+ characters). Door staff: /door and /raffle-desk (8+ characters).
ADMIN_TOKEN=
DOOR_TOKEN=
# Card payments (Stripe Checkout). Without a key, bookings are reserved and invoiced.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Ticket and follower emails (Resend)
RESEND_API_KEY=
MAIL_FROM=TAM <tickets@tam.tv>
MAIL_REPLY_TO=
# Party Wall pins go live without review when set to off
PIN_MODERATION=on
