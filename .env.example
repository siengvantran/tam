# Public URL used in canonical links, sitemap and structured data
SITE_URL=https://tam.tv
# Where submissions, sign-ups and consented analytics are written (mount a Railway volume here)
DATA_DIR=/data
# Staff sign-in for /box-office and /studio (use a long random string)
ADMIN_TOKEN=
# Paid tickets (Stripe Checkout). Without these, only free tickets can be issued.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: enables the Production Agent in /studio
ANTHROPIC_API_KEY=
